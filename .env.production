# Loaded by `vite build`. The mock layer must never ship to production.
VITE_USE_MOCK="false"

# The Flask backend's base URL. Set the real value as a Vercel env var
# (Project → Settings → Environment Variables) — that overrides this file.
# Use a *.coindrop.cc host so the session cookie stays same-site (SameSite=Lax).
#   e.g. VITE_API_URL=https://api.coindrop.cc
VITE_API_URL=""
